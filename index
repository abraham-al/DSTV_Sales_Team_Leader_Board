                });
            }

            if (activeRosterView === 'tl') {
                const regionsToDisplay = ["Central", "East", "South"];

                regionsToDisplay.forEach(regionName => {
                    const regionFiltered = computed.filter(t => t.region === regionName);
                    
                    // Create Region Card Container (Widened, Grand visual steps, stripped of 'Arena' / 'Region Pool' tags)
                    const regCard = document.createElement("div");
                    regCard.className = "p-6 bg-slate-900/40 rounded-2xl border border-white/5 space-y-4";
                    regCard.innerHTML = `
                        <div class="flex items-center justify-between border-b border-white/5 pb-2.5">
                            <h3 class="font-extrabold text-sm text-goldMedal flex items-center gap-1.5 uppercase tracking-wider">
                                📍 ${regionName} Territory
                            </h3>
                        </div>
                        <div class="flex flex-col sm:flex-row items-center sm:items-end justify-center gap-4 sm:gap-8 pt-4 w-full" id="visual-podium-${regionName}">
                        </div>
                    `;
                    podiumsOuterContainer.appendChild(regCard);

                    const visualPodium = document.getElementById(`visual-podium-${regionName}`);
                    
                    const top3 = regionFiltered.slice(0, 3);
                    const podiumOrder = [];
                    if (top3[1]) podiumOrder.push({ pos: 2, item: top3[1], bg: 'border-slate-400', height: 'h-44 sm:h-52', medal: '🥈', size: 'scale-95' });
                    if (top3[0]) podiumOrder.push({ pos: 1, item: top3[0], bg: 'border-goldMedal', height: 'h-52 sm:h-64', medal: '🥇', size: 'scale-110 z-10' });
                    if (top3[2]) podiumOrder.push({ pos: 3, item: top3[2], bg: 'border-orange-400', height: 'h-36 sm:h-44', medal: '🥉', size: 'scale-90' });

                    podiumOrder.forEach(pod => {
                        const el = document.createElement("div");
                        el.className = `flex flex-col items-center w-full sm:w-48 text-center transform hover:scale-105 transition-all ${pod.size}`;

                        const rewardDisplay = pod.item.prizeValue > 0 
                            ? `<div class="mt-2 p-1.5 bg-slate-950/80 rounded-lg border border-goldMedal/30 flex flex-col items-center justify-center">
                                    ${pod.item.prizeIcon}
                                    <span class="block text-xs text-goldMedal font-black mt-1 uppercase tracking-wider">15,000 ETB</span>
                                    <span class="text-[8px] text-slate-300 font-bold block truncate max-w-[120px]">${pod.item.prizeName}</span>
                               </div>`
                            : `<span class="block text-xs text-red-400 font-extrabold mt-1">Ineligible</span>`;

                        el.innerHTML = `
                            <div class="text-4xl mb-1">${pod.medal}</div>
                            <div class="text-base font-black text-white truncate w-full px-1">${pod.item.name}</div>
                            <div class="text-xs text-slate-400 truncate w-full mb-1">${pod.item.detail}</div>
                            
                            <div class="w-full ${pod.height} bg-gradient-to-t from-slate-950 to-slate-900 border-t-8 ${pod.bg} rounded-t-2xl mt-3 flex flex-col justify-between p-4 relative shadow-2xl">
                                <span class="text-3xl font-black text-white/10">${pod.pos}</span>
                                <div class="text-base font-black text-slate-200 leading-none">${pod.item.totalScore.toFixed(1)}% Score</div>
                                <div class="text-xs text-slate-300 mt-1 font-extrabold leading-tight">
                                    MTD: <span class="text-turfGreen">${pod.item.actual}</span> / ${pod.item.target} NNs
                                </div>
                                <div class="text-[10px] text-slate-400 font-bold">Achieved: ${Math.round(pod.item.achPercent * 100)}%</div>
                                ${rewardDisplay}
                            </div>
                        `;
                        visualPodium.appendChild(el);
                    });

                    // Regional Runner-ups (4th & 5th)
                    const runners = regionFiltered.slice(3, 5);
                    if (runners.length > 0) {
                        const runnersWrapper = document.createElement("div");
                        runnersWrapper.className = "grid grid-cols-1 sm:grid-cols-2 gap-2 mt-4 pt-4 border-t border-white/5";
                        regCard.appendChild(runnersWrapper);

                        runners.forEach((run, idx) => {
                            const runCard = document.createElement("div");
                            runCard.className = "p-3 bg-slate-950/40 rounded-xl text-xs flex justify-between items-center";

                            const prizeText = run.prizeValue > 0 ? "🎁 Tablet / Watch (15,000 ETB)" : "Ineligible";

                            runCard.innerHTML = `
                                <div>
                                    <span class="font-bold text-slate-400">#${idx+4}</span>
                                    <span class="text-white font-bold ml-1">${run.name}</span>
                                    <span class="text-slate-500 text-[10px] block">${run.detail}</span>
                                </div>
                                <div class="text-right">
                                    <span class="text-slate-300 font-bold block">MTD: ${run.actual} / ${run.target} NNs (${run.totalScore.toFixed(1)}% Score)</span>
                                    <span class="text-goldMedal text-[10px] font-extrabold">${prizeText}</span>
                                </div>
                            `;
                            runnersWrapper.appendChild(runCard);
                        });
                    }
                });

                const grandWinnerTL = computed.find(t => t.grandPrizeEligibility);
                if (grandWinnerTL) {
                    const championshipBanner = document.createElement("div");
                    championshipBanner.className = "p-5 bg-gradient-to-r from-yellow-600/20 via-slate-900 to-yellow-600/20 rounded-xl border border-goldMedal/30 text-center relative overflow-hidden";
                    championshipBanner.innerHTML = `
                        <div class="absolute -top-12 -left-12 w-24 h-24 bg-goldMedal/10 rounded-full filter blur-xl"></div>
                        <p class="text-xs font-black uppercase text-goldMedal tracking-widest mb-1">🔥 Projected Promo Period Champion</p>
                        <p class="text-xl font-black text-white">${grandWinnerTL.name} (${grandWinnerTL.region})</p>
                        <div class="flex items-center justify-center gap-3 mt-2 text-sm text-slate-300">
                             <span class="text-4xl text-goldMedal">💻</span>
                             <div class="text-left leading-snug">
                                 Winning overall prize: <strong class="text-goldMedal">Core i7 Laptop (60,000 ETB Value)</strong>
                                 <br/><span class="text-xs text-slate-400">Score: ${grandWinnerTL.totalScore.toFixed(1)}% | MTD: ${grandWinnerTL.actual} / ${grandWinnerTL.target} NNs</span>
                             </div>
                        </div>
                    `;
                    podiumsOuterContainer.prepend(championshipBanner);
                }

            } else {
                const singlePodium = document.createElement("div");
                singlePodium.className = "flex flex-col sm:flex-row items-center sm:items-end justify-center gap-4 sm:gap-8 pt-6 pb-2 border-b border-white/10 w-full";
                podiumsOuterContainer.appendChild(singlePodium);

                const top3 = computed.slice(0, 3);
                const podiumOrder = [];
                if (top3[1]) podiumOrder.push({ pos: 2, item: top3[1], bg: 'border-slate-400', height: 'h-44 sm:h-56', medal: '🥈', size: 'scale-95' });
                if (top3[0]) podiumOrder.push({ pos: 1, item: top3[0], bg: 'border-goldMedal', height: 'h-56 sm:h-72', medal: '🥇', size: 'scale-110 z-10' });
                if (top3[2]) podiumOrder.push({ pos: 3, item: top3[2], bg: 'border-orange-400', height: 'h-36 sm:h-48', medal: '🥉', size: 'scale-90' });

                podiumOrder.forEach(pod => {
                    const el = document.createElement("div");
                    el.className = `flex flex-col items-center w-full sm:w-48 text-center transform hover:scale-105 transition-all ${pod.size}`;

                    let rankPrizeLabel = "";
                    let customValText = "";
                    if (pod.item.prizeValue > 0) {
                        if (activeRosterView === 'tsm') {
                            rankPrizeLabel = pod.pos === 1 ? "High‑End Phone" : (pod.pos === 2 ? "Smart Watch" : "Tablet");
                            customValText = pod.pos === 1 ? "40,000 ETB" : (pod.pos === 2 ? "25,000 ETB" : "20,000 ETB");
                        } else if (activeRosterView === 'territory') {
                            rankPrizeLabel = pod.pos === 1 ? "Team Exp + Trophy" : (pod.pos === 2 ? "Equipment Pack" : "Kits & Tools");
                            customValText = pod.pos === 1 ? "50,000 ETB" : (pod.pos === 2 ? "30,000 ETB" : "25,000 ETB");
                        } else {
                            rankPrizeLabel = pod.item.prizeName;
                            customValText = pod.item.prizeValue.toLocaleString() + " ETB";
                        }
                    } else {
                        rankPrizeLabel = "Ineligible";
                    }

                    const rewardDisplay = pod.item.prizeValue > 0 
                        ? `<div class="mt-2 p-1.5 bg-slate-950/80 rounded-lg border border-goldMedal/30 flex flex-col items-center justify-center">
                                ${pod.item.prizeIcon}
                                <span class="block text-xs text-goldMedal font-black mt-1 uppercase tracking-wider">${customValText}</span>
                                <span class="text-[8px] text-slate-300 font-bold block truncate max-w-[120px]">${rankPrizeLabel}</span>
                           </div>`
                        : `<span class="block text-xs text-red-400 font-extrabold mt-1">⚠️ Disqualified</span>`;

                    el.innerHTML = `
                        <div class="mb-1 text-4xl">${pod.medal}</div>
                        <div class="text-base font-black text-white truncate w-full px-1">${pod.item.name}</div>
                        <div class="text-xs text-slate-400">${pod.item.detail}</div>
                        
                        <div class="w-full ${pod.height} bg-gradient-to-t from-slate-900 to-slate-800/90 border-t-8 ${pod.bg} rounded-t-2xl mt-3 flex flex-col justify-between p-4 relative shadow-2xl">
                            <span class="text-3xl font-black text-white/50">${pod.pos}</span>
                            <div class="text-base font-black text-slate-200 leading-none">${pod.item.totalScore.toFixed(1)}% Score</div>
                            <div class="text-xs text-slate-300 mt-1 font-extrabold leading-tight">
                                MTD: <span class="text-turfGreen">${pod.item.actual}</span> / ${pod.item.target} NNs
                            </div>
                            <div class="text-[10px] text-slate-400 font-bold">Achieved: ${Math.round(pod.item.achPercent * 100)}%</div>
                            ${rewardDisplay}
                        </div>
                    `;
                    singlePodium.appendChild(el);
                });

                const grandWinner = computed.find(t => t.grandPrizeEligibility);
                if (grandWinner) {
                    let grandPrizeText = "";
                    let grandPrizeIcon = "";
                    if (activeRosterView === 'tsm') {
                        grandPrizeText = "TSM Champion Promo Travel (100,000 ETB)";
                        grandPrizeIcon = "✈️";
                    } else if (activeRosterView === 'territory') {
                        grandPrizeText = "Best Territory Promo Team Trip (100,000 ETB)";
                        grandPrizeIcon = "🏕️";
                    } else if (activeRosterView === 'region') {
                        grandPrizeText = "Best Region Executive Reward (150,000 ETB)";
                        grandPrizeIcon = "🏆";
                    } else if (activeRosterView === 'rhos') {
                        grandPrizeText = "Regional Head Executive Reward (200,000 ETB)";
                        grandPrizeIcon = "👑";
                    }

                    const championshipBanner = document.createElement("div");
                    championshipBanner.className = "p-5 bg-gradient-to-r from-yellow-600/20 via-slate-900 to-yellow-600/20 rounded-xl border border-goldMedal/30 text-center mt-4";
                    championshipBanner.innerHTML = `
                        <p class="text-xs font-black uppercase text-goldMedal tracking-widest mb-1">🔥 Projected Promo Period Champion</p>
                        <p class="text-xl font-black text-white">${grandWinner.name} (${grandWinner.region})</p>
                        <div class="flex items-center justify-center gap-3 mt-2 text-sm text-slate-300">
                             <span class="text-4xl">${grandPrizeIcon}</span>
                             <div class="text-left leading-snug">
                                 Winning grand prize: <strong class="text-goldMedal">${grandPrizeText}</strong>
                                 <br/><span class="text-xs text-slate-400">Score: ${grandWinner.totalScore.toFixed(1)}% | MTD: ${grandWinner.actual} / ${grandWinner.target} NNs</span>
                             </div>
                        </div>
                    `;
                    podiumsOuterContainer.prepend(championshipBanner);
                }

                // National Runner Ups (4th & 5th)
                const runners = computed.slice(3, 5);
                runners.forEach((run, idx) => {
                    const pos = idx + 4;
                    const card = document.createElement("div");
                    card.className = "p-3 bg-slate-900/60 rounded-xl border border-white/5 flex items-center justify-between";

                    const prizeTag = run.prizeValue > 0 
                        ? `<span class="text-xs font-extrabold text-goldMedal">🎁 ${run.prizeName}</span>`
                        : `<span class="text-xs text-red-400">Ineligible</span>`;

                    card.innerHTML = `
                        <div class="flex items-center gap-3">
                            <span class="text-xs font-bold text-slate-500">#${pos}</span>
                            <div>
                                <p class="text-xs font-bold text-white">${run.name}</p>
                                <p class="text-[9px] text-slate-400">${run.detail}</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-xs font-bold text-slate-200">MTD: ${run.actual} / ${run.target} NNs (${run.totalScore.toFixed(1)}% Score)</p>
                            ${prizeTag}
                        </div>
                    `;
                    runnersContainer.appendChild(card);
                });
            }
        }

        // Helper
        function getTerrName(id) {
            const t = localTerritories.find(item => item.id === id);
            return t ? t.name : "N/A";
        }

        function showToast(message, type = "info") {
            const container = document.getElementById("toast-container");
            if (!container) return;

            const toast = document.createElement("div");
            
            let bgClass = "bg-slate-900 border-multiBlue text-blue-200";
            let icon = "💡";

            if (type === "success") {
                bgClass = "bg-slate-900 border-turfGreen text-emerald-300";
                icon = "🏆";
            } else if (type === "warning") {
                bgClass = "bg-slate-900 border-crimsonFoul text-red-300";
                icon = "⚠️";
            }

            toast.className = `p-3 rounded-xl border-l-4 ${bgClass} shadow-2xl text-xs max-w-sm flex gap-3 items-center transform translate-y-2 opacity-0 transition-all duration-300`;
            toast.innerHTML = `
                <span class="text-base">${icon}</span>
                <span class="flex-1 font-semibold">${message}</span>
            `;

            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.remove("translate-y-2", "opacity-0");
            }, 50);

            setTimeout(() => {
                toast.classList.add("opacity-0", "translate-y-2");
                setTimeout(() => {
                    toast.remove();
                }, 300);
            }, 3000);
        }
    </script>
</body>
</html>
