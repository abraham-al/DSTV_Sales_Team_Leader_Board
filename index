        function parseSpreadsheetData() {
            const rawText = document.getElementById("sheets-paste-area").value.trim();
            if (!rawText) {
                showToast("⚠️ Paste area is empty! Please paste spreadsheet rows.", "warning");
                return;
            }

            const lines = rawText.split(/\r?\n/);
            if (lines.length < 2) {
                showToast("⚠️ Missing data rows. Ensure you copied both the header and data.", "warning");
                return;
            }

            const firstLine = lines[0];
            const delimiter = firstLine.includes("\t") ? "\t" : ",";
            const headers = firstLine.split(delimiter).map(h => h.trim().toLowerCase());

            const getIndex = (aliases) => headers.findIndex(h => aliases.some(alias => h.includes(alias)));

            const nameIdx = getIndex(["name", "leader", "tsm", "manager", "head", "candidate"]);
            const targetIdx = getIndex(["target", "goal", "quota"]);
            const actualIdx = getIndex(["actual", "sales", "activation", "activated", "nns"]);
            const disciplineIdx = getIndex(["discipline", "compliant", "conduct", "clean"]);
            const regionIdx = getIndex(["region", "zone", "region name"]);
            const territoryIdx = getIndex(["territory", "city", "place", "portfolio", "territory name"]);
            const bouquetIdx = getIndex(["bouquet", "quality", "mix"]);
            const fssIdx = getIndex(["fss", "audit", "fss score"]);

            let importCount = 0;

            if (activeImportType === "tl") {
                if (nameIdx === -1 || targetIdx === -1 || actualIdx === -1) {
                    showToast("❌ Parsing failed. Could not find Name, Target, and MTD NNs columns for TL.", "warning");
                    return;
                }
                const parsedTLs = [];
                for (let i = 1; i < lines.length; i++) {
                    const cols = lines[i].split(delimiter).map(c => c.trim());
                    if (cols.length < 3 || !cols[nameIdx]) continue;

                    let matchedTerrId = "T1";
                    if (territoryIdx !== -1 && cols[territoryIdx]) {
                        const terrName = cols[territoryIdx].toLowerCase();
                        const foundTerr = localTerritories.find(t => t.name.toLowerCase() === terrName);
                        if (foundTerr) {
                            matchedTerrId = foundTerr.id;
                        } else {
                            const newId = "T" + (localTerritories.length + 1);
                            const regName = regionIdx !== -1 ? cols[regionIdx] : "Central";
                            localTerritories.push({
                                id: newId,
                                name: cols[territoryIdx],
                                region: regName,
                                target: parseInt(cols[targetIdx]) || 1000,
                                actual: parseInt(cols[actualIdx]) || 0,
                                discipline: true,
                                tsm: "Assigned TSM",
                                fss: 3,
                                bouquet: "Medium"
                            });
                            matchedTerrId = newId;
                        }
                    }

                    parsedTLs.push({
                        id: 100 + i,
                        name: cols[nameIdx],
                        territoryId: matchedTerrId,
                        target: parseInt(cols[targetIdx]) || 1000,
                        actual: parseInt(cols[actualIdx]) || 0,
                        discipline: disciplineIdx !== -1 ? ["yes", "true", "1", "clean"].includes(cols[disciplineIdx].toLowerCase()) : true,
                        bouquet: bouquetIdx !== -1 ? cols[bouquetIdx] : "Medium"
                    });
                    importCount++;
                }

                if (parsedTLs.length > 0) {
                    localTLs = parsedTLs;
                    setRosterView("tl");
                    showToast(`✅ Successfully imported ${importCount} Team Leaders MTD achievements!`, "success");
                }

            } else if (activeImportType === "tsm") {
                if (nameIdx === -1 || targetIdx === -1 || actualIdx === -1) {
                    showToast("❌ Parsing failed. Could not find Name, Target, and MTD NNs columns for TSM.", "warning");
                    return;
                }
                const parsedTSMs = [];
                for (let i = 1; i < lines.length; i++) {
                    const cols = lines[i].split(delimiter).map(c => c.trim());
                    if (cols.length < 3 || !cols[nameIdx]) continue;

                    const terrName = territoryIdx !== -1 ? cols[territoryIdx] : cols[nameIdx] + " Terr";
                    const regName = regionIdx !== -1 ? cols[regionIdx] : "Central";

                    // Update or insert into territories mockup
                    const existingTerrIndex = localTerritories.findIndex(t => t.name.toLowerCase() === terrName.toLowerCase());
                    const tsmObj = {
                        id: "T" + (100 + i),
                        name: terrName,
                        region: regName,
                        target: parseInt(cols[targetIdx]) || 1000,
                        actual: parseInt(cols[actualIdx]) || 0,
                        discipline: disciplineIdx !== -1 ? ["yes", "true", "1", "clean"].includes(cols[disciplineIdx].toLowerCase()) : true,
                        tsm: cols[nameIdx],
                        fss: fssIdx !== -1 ? parseFloat(cols[fssIdx]) || 3 : 3,
                        bouquet: bouquetIdx !== -1 ? cols[bouquetIdx] : "Medium"
                    };

                    if (existingTerrIndex > -1) {
                        localTerritories[existingTerrIndex] = { ...localTerritories[existingTerrIndex], ...tsmObj, id: localTerritories[existingTerrIndex].id };
                    } else {
                        localTerritories.push(tsmObj);
                    }
                    importCount++;
                }
                setRosterView("tsm");
                showToast(`✅ Successfully parsed & sync'd ${importCount} TSM Portfolios!`, "success");

            } else if (activeImportType === "territory") {
                const termCol = territoryIdx !== -1 ? territoryIdx : nameIdx;
                if (termCol === -1 || targetIdx === -1 || actualIdx === -1) {
                    showToast("❌ Parsing failed. Could not find Territory Name, Target, and MTD NNs columns.", "warning");
                    return;
                }
                for (let i = 1; i < lines.length; i++) {
                    const cols = lines[i].split(delimiter).map(c => c.trim());
                    if (cols.length < 3 || !cols[termCol]) continue;

                    const terrName = cols[termCol];
                    const regName = regionIdx !== -1 ? cols[regionIdx] : "Central";
                    const tsmName = nameIdx !== -1 ? cols[nameIdx] : "Unassigned TSM";

                    const existingIndex = localTerritories.findIndex(t => t.name.toLowerCase() === terrName.toLowerCase());
                    const terrObj = {
                        name: terrName,
                        region: regName,
                        target: parseInt(cols[targetIdx]) || 3000,
                        actual: parseInt(cols[actualIdx]) || 0,
                        discipline: disciplineIdx !== -1 ? ["yes", "true", "1", "clean"].includes(cols[disciplineIdx].toLowerCase()) : true,
                        tsm: tsmName,
                        fss: fssIdx !== -1 ? parseFloat(cols[fssIdx]) || 3 : 3,
                        bouquet: bouquetIdx !== -1 ? cols[bouquetIdx] : "Medium"
                    };

                    if (existingIndex > -1) {
                        localTerritories[existingIndex] = { ...localTerritories[existingIndex], ...terrObj };
                    } else {
                        localTerritories.push({ id: "T" + (200 + i), ...terrObj });
                    }
                    importCount++;
                }
                setRosterView("territory");
                showToast(`✅ Imported & integrated ${importCount} Territory datasets!`, "success");

            } else if (activeImportType === "region") {
                const regCol = regionIdx !== -1 ? regionIdx : nameIdx;
                if (regCol === -1) {
                    showToast("❌ Parsing failed. Region Name column not identified.", "warning");
                    return;
                }
                for (let i = 1; i < lines.length; i++) {
                    const cols = lines[i].split(delimiter).map(c => c.trim());
                    if (cols.length < 1 || !cols[regCol]) continue;

                    const rName = cols[regCol];
                    const rHead = nameIdx !== -1 ? cols[nameIdx] : "Mamush Yohannes";

                    const existingIndex = localRegions.findIndex(r => r.name.toLowerCase() === rName.toLowerCase());
                    if (existingIndex > -1) {
                        localRegions[existingIndex].head = rHead;
                    } else {
                        localRegions.push({ id: "R" + (100 + i), name: rName, head: rHead });
                    }
                    importCount++;
                }
                setRosterView("region");
                showToast(`✅ Successfully imported region attributes: ${importCount} regions recorded!`, "success");

            } else if (activeImportType === "rhos") {
                if (nameIdx === -1) {
                    showToast("❌ Parsing failed. Missing Regional Head Name column.", "warning");
                    return;
                }
                for (let i = 1; i < lines.length; i++) {
                    const cols = lines[i].split(delimiter).map(c => c.trim());
                    if (cols.length < 1 || !cols[nameIdx]) continue;

                    const headName = cols[nameIdx];
                    const rName = regionIdx !== -1 ? cols[regionIdx] : "Central";

                    const existingIndex = localRegions.findIndex(r => r.name.toLowerCase() === rName.toLowerCase());
                    if (existingIndex > -1) {
                        localRegions[existingIndex].head = headName;
                    } else {
                        localRegions.push({ id: "R" + (200 + i), name: rName, head: headName });
                    }
                    importCount++;
                }
                setRosterView("rhos");
                showToast(`✅ Synced ${importCount} Regional Heads of Sales (RHoS)!`, "success");
            }

            renderDashboard();
        }

        function onAgentSearchChange() {
            const query = document.getElementById("agent-search-input").value.trim().toLowerCase();
            const heroCard = document.getElementById("motivation-hero-card");
            
            if (!query) {
                heroCard.innerHTML = `<p class="text-xs text-slate-400 italic">Enter your name on the left to see your personalized standings ticket.</p>`;
                return;
            }

            // Consolidate current context scores
            let pool = [];
            if (activeRosterView === 'tl') {
                pool = localTLs.map(tl => {
                    const ach = tl.actual / tl.target;
                    const nnsPoints = ach < 0.95 ? 0 : Math.min(95, 95 * Math.min(1.10, ach));
                    const totalScore = nnsPoints + (tl.discipline ? 5 : 0);
                    return { name: tl.name, target: tl.target, actual: tl.actual, score: totalScore, isEligible: totalScore >= 95 && tl.discipline, region: getTerrRegionName(tl.territoryId) };
                });
            } else if (activeRosterView === 'tsm') {
                pool = localTerritories.map(t => {
                    const ach = t.actual / t.target;
                    const nnsPoints = ach < 0.95 ? 0 : Math.min(95, 95 * Math.min(1.10, ach));
                    const totalScore = nnsPoints + (t.discipline ? 2 : 0) + t.fss;
                    return { name: t.tsm, target: t.target, actual: t.actual, score: totalScore, isEligible: totalScore >= 95 && t.discipline, region: t.region };
                });
            } else if (activeRosterView === 'territory') {
                pool = localTerritories.map(t => {
                    const ach = t.actual / t.target;
                    const nnsPoints = ach < 0.95 ? 0 : Math.min(95, 95 * Math.min(1.10, ach));
                    const totalScore = nnsPoints + (t.discipline ? 5 : 0);
                    return { name: t.name, target: t.target, actual: t.actual, score: totalScore, isEligible: totalScore >= 95 && t.discipline, region: t.region };
                });
            } else {
                pool = localRegions.map(reg => {
                    const associated = localTerritories.filter(t => t.region === reg.name);
                    const totTarget = associated.reduce((s,t) => s + t.target, 0);
                    const totActual = associated.reduce((s,t) => s + t.actual, 0);
                    const ach = totActual / totTarget;
                    const nnsPoints = ach < 0.95 ? 0 : Math.min(95, 95 * Math.min(1.10, ach));
                    const totalScore = nnsPoints + 5;
                    return { name: activeRosterView === 'rhos' ? reg.head : reg.name, target: totTarget, actual: totActual, score: totalScore, isEligible: totalScore >= 95, region: reg.name };
                });
            }

            // Find matching candidate
            const matching = pool.find(item => item.name.toLowerCase().includes(query));
            if (!matching) {
                heroCard.innerHTML = `<p class="text-xs text-crimsonFoul font-bold">⚠️ No matching active candidate found in the loaded roster. Check spelling.</p>`;
                return;
            }

            // Sort pool to find ranks
            pool.sort((a,b) => b.score - a.score);
            const globalRank = pool.findIndex(item => item.name === matching.name) + 1;

            // Sort region pool
            const regionPool = pool.filter(item => item.region === matching.region);
            regionPool.sort((a,b) => b.score - a.score);
            const regionalRank = regionPool.findIndex(item => item.name === matching.name) + 1;

            // Find the 3rd place threshold target inside their regional / global pool to calculate distance
            const targetThirdPlace = activeRosterView === 'tl' ? regionPool[2] : pool[2];
            let varianceMessage = "";

            if (targetThirdPlace) {
                const scoreDiff = targetThirdPlace.score - matching.score;
                const salesDiff = targetThirdPlace.actual - matching.actual;

                if (scoreDiff <= 0) {
                    varianceMessage = `<span class="text-turfGreen font-black">🔥 FANTASTIC! You are already on the qualifying Podium! Maintain performance to secure your reward.</span>`;
                } else {
                    varianceMessage = `You are only <strong class="text-goldMedal">${scoreDiff.toFixed(1)}% Score</strong> (approx. <strong class="text-goldMedal">${salesDiff > 0 ? salesDiff : 5} NNs</strong>) behind the 3rd place podium. <span class="text-multiBlue font-bold">We Make It Possible!</span>`;
                }
            } else {
                varianceMessage = `Keep pushing sales metrics to build the championship pool rankings!`;
            }

            heroCard.innerHTML = `
                <div class="flex flex-col md:flex-row justify-between items-center w-full gap-4">
                    <div class="text-left">
                        <p class="text-[9px] text-slate-400 uppercase font-extrabold leading-none">Personal Championship Status Card</p>
                        <p class="text-lg font-black text-white mt-1">${matching.name} (${matching.region})</p>
                        <p class="text-xs text-slate-300 mt-1">Global Standing: <strong class="text-goldMedal">Rank #${globalRank}</strong> (Score: ${matching.score.toFixed(1)}%)</p>
                        <p class="text-xs text-slate-300">Achievement: <strong class="text-white">${matching.actual} / ${matching.target} NNs</strong></p>
                        ${activeRosterView === 'tl' ? `<p class="text-xs text-slate-300 font-semibold">Regional Standing: <strong class="text-goldMedal">Rank #${regionalRank} in ${matching.region}</strong></p>` : ''}
                    </div>
                    <div class="p-3 bg-slate-950/80 rounded-xl border border-white/5 max-w-sm text-xs leading-normal">
                        ${varianceMessage}
                    </div>
                </div>
            `;
        }

